# ==============================================================================
# gateway-edge/.env.example — committed template, NO real values
# ==============================================================================
# LOCAL / EC2:   cp gateway-edge/.env.example gateway-edge/.env  → fill values
# PRODUCTION:    add each variable in your platform dashboard (Vercel / Render)
# ==============================================================================

# ── JWT ───────────────────────────────────────────────────────────────────────
# ⚠ Must match JWT_SECRET in gateway-control-plane and uam-backend
JWT_SECRET=
# Optional: JSON object of kid→secret for zero-downtime key rotation
# e.g. {"v2":"newsecret","v1":"oldsecret"}
JWT_KEYS=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional: Redis ACL username (leave blank if not using ACL)
REDIS_USERNAME=
REDIS_TLS=true
REDIS_DB=0

# ── Control plane ─────────────────────────────────────────────────────────────
# Docker Compose: http://control-plane:8081
# Production:     your deployed gateway-control-plane URL
CONTROL_PLANE_URL=
GATEWAY_CONFIG_PATH=/etc/gateway/config.json
CONFIG_POLL_SECS=5
CONFIG_READ_TOKEN=

# ── Region ────────────────────────────────────────────────────────────────────
GATEWAY_REGION=GLOBAL
FALLBACK_REGION=US

# ── Security ──────────────────────────────────────────────────────────────────
REVOCATION_FAIL_CLOSED=1
GATEWAY_REFUSE_INSECURE_SECRETS=1
AUTH_CACHE_TTL_SECS=30
WAF_IP_RATE_LIMIT_RPS=100

# ── TLS ───────────────────────────────────────────────────────────────────────
TLS_ENABLED=false
TLS_CERT_PATH=/etc/nginx/certs/server.crt
TLS_KEY_PATH=/etc/nginx/certs/server.key

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=warn

# ── Metrics ───────────────────────────────────────────────────────────────────
# Set 0 on Render so it is not picked up as the web port
METRICS_PORT=0
METRICS_BIND=0.0.0.0

# ── Distributed Rate Limiting (Redis fleet-wide sync) ─────────────────────────
# Set false to run local-only (per-node) rate limiting — pre-v0.7 behaviour
RATE_LIMIT_REDIS_ENABLED=true
# Redis command timeout for rate-limit syncs [5, 500] ms
RATE_LIMIT_REDIS_TIMEOUT_MS=50
# Optional: full Redis URL (takes precedence over REDIS_HOST/PORT/PASSWORD/TLS)
# e.g. rediss://default:password@host.upstash.io:6379
REDIS_URL=

# ── Redis Circuit Breaker ─────────────────────────────────────────────────────
# Rolling window size in seconds (how long health evidence is retained)
REDIS_CB_WINDOW_SECS=10
# Minimum observations before statistical detector activates (prevents tiny-sample flap)
REDIS_CB_MIN_SAMPLES=20
# Consecutive failures before fast-OPEN [1, 100]
REDIS_CB_CONSECUTIVE_FAIL_OPEN=5
# Consecutive timeouts before fast-OPEN [1, 100]
REDIS_CB_CONSECUTIVE_TIMEOUT_OPEN=3
# Rolling error rate threshold for statistical OPEN [0.0, 1.0]
REDIS_CB_ERROR_RATE_OPEN=0.5
# Rolling timeout rate threshold for statistical OPEN [0.0, 1.0]
REDIS_CB_TIMEOUT_RATE_OPEN=0.4
# Rolling p99 latency threshold for statistical OPEN (µs) — 200ms default
REDIS_CB_P99_US_OPEN=200000
# p99 latency must be BELOW this to allow HALF_OPEN → CLOSED recovery (µs) — 30ms
REDIS_CB_P99_US_RECOVERY=30000
# Error rate must be BELOW this for HALF_OPEN → CLOSED recovery
REDIS_CB_ERROR_RATE_RECOVERY=0.1
# Base cooldown before OPEN → HALF_OPEN (ms)
REDIS_CB_OPEN_COOLDOWN_MS=5000
# Max random jitter added to cooldown (ms) — prevents fleet recovery storms
REDIS_CB_COOLDOWN_JITTER_MS=2000
# Number of probe requests allowed in HALF_OPEN state
REDIS_CB_HALF_OPEN_PROBES=3
# Consecutive probe successes needed to close the circuit
REDIS_CB_RECOVERY_SUCCESSES=3
# Max Redis operations in flight (concurrency back-pressure)
REDIS_CB_MAX_INFLIGHT=32
