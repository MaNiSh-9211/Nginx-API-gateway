# ==============================================================================
# gateway-edge/.env.example — committed template, NO real values
# ==============================================================================
# LOCAL / EC2:   cp gateway-edge/.env.example gateway-edge/.env  → fill values
# PRODUCTION:    add each variable in your platform dashboard (Vercel / Render)
# ==============================================================================

# ── JWT ───────────────────────────────────────────────────────────────────────
# ⚠ Must match JWT_SECRET in gateway-control-plane and uam-backend
JWT_SECRET=
# Optional: JSON object of kid→secret for zero-downtime key rotation
# e.g. {"v2":"newsecret","v1":"oldsecret"}
JWT_KEYS=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional: Redis ACL username (leave blank if not using ACL)
REDIS_USERNAME=
REDIS_TLS=true
REDIS_DB=0

# ── Control plane ─────────────────────────────────────────────────────────────
# Docker Compose: http://control-plane:8081
# Production:     your deployed gateway-control-plane URL
CONTROL_PLANE_URL=
GATEWAY_CONFIG_PATH=/etc/gateway/config.json
CONFIG_POLL_SECS=5
CONFIG_READ_TOKEN=

# ── Region ────────────────────────────────────────────────────────────────────
GATEWAY_REGION=GLOBAL
FALLBACK_REGION=US

# ── Security ──────────────────────────────────────────────────────────────────
REVOCATION_FAIL_CLOSED=1
GATEWAY_REFUSE_INSECURE_SECRETS=1
AUTH_CACHE_TTL_SECS=30
WAF_IP_RATE_LIMIT_RPS=100

# ── TLS ───────────────────────────────────────────────────────────────────────
TLS_ENABLED=false
TLS_CERT_PATH=/etc/nginx/certs/server.crt
TLS_KEY_PATH=/etc/nginx/certs/server.key

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=warn

# ── Metrics ───────────────────────────────────────────────────────────────────
# Set 0 on Render so it is not picked up as the web port
METRICS_PORT=0
METRICS_BIND=0.0.0.0
