# ==============================================================================
# demo-frontend/.env.example — committed template, NO real values
# ==============================================================================
# LOCAL / EC2:   cp demo-frontend/.env.example demo-frontend/.env  → fill values
# PRODUCTION:    add each variable in your platform dashboard (Vercel / Render)
# ==============================================================================

# ── Port (Docker / local only) ────────────────────────────────────────────────
FRONTEND_TEST_PORT=8090

# ── Gateway proxy (nginx runtime variable) ────────────────────────────────────
# Docker Compose: gateway-edge  and  8080
# Production:     your gateway-edge internal service hostname
GATEWAY_INTERNAL_HOST=
GATEWAY_INTERNAL_PORT=8080

# ── UAM frontend URL ──────────────────────────────────────────────────────────
# Docker Compose: http://uam-frontend:80
# Production:     your deployed uam-frontend URL
UAM_FRONTEND_URL=
