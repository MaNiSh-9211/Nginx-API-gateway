worker_processes 1;

events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    server_tokens off;

    map $http_x_forwarded_proto $hsts_header {
        default "";
        https   "max-age=31536000; includeSubDomains; preload";
    }

    map $http_x_forwarded_proto $csp_upgrade {
        default "";
        https   " upgrade-insecure-requests;";
    }

    server {
        listen 80;
        server_name _;
        server_tokens off;

    

        include /etc/nginx/cloudflare/security-headers.conf;

        root /usr/share/nginx/html;
        index index.html;

        include /etc/nginx/cloudflare/cdn-static.conf;

        location / {
            try_files $uri $uri/ /index.html;
        }

        # GATEWAY_PROXY_BASE / GATEWAY_PROXY_HOST — set at runtime (Render dashboard).
        # Defaults in docker-entrypoint.sh: http://gateway:8080 + gateway (Compose).
        # NOTE: proxy_pass uses a VARIABLE so nginx re-resolves DNS at runtime
        # (valid=10s). A literal proxy_pass freezes the upstream IP at startup —
        # recreating the gateway container then 502s every API call.
        location /api/ {
            include /etc/nginx/cloudflare/security-headers.conf;
            resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
            resolver_timeout 5s;
            set $gateway_upstream_base "${GATEWAY_PROXY_BASE}";
            set $gateway_upstream_host "${GATEWAY_PROXY_HOST}";
            add_header Cache-Control "no-store, private" always;
            add_header CDN-Cache-Control "no-store" always;
            proxy_pass $gateway_upstream_base$request_uri;
            proxy_ssl_server_name on;
            proxy_set_header Host $gateway_upstream_host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_read_timeout 60s;
        }

        location /stub_status {
            stub_status on;
            access_log off;
            allow 10.0.0.0/8;
            allow 172.16.0.0/12;
            allow 192.168.0.0/16;
            allow 127.0.0.1;
            deny all;
        }
    }
}
