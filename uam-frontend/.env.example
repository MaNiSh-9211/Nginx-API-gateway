# ==============================================================================
# uam-frontend/.env.example — committed template, NO real values
# ==============================================================================
# LOCAL / EC2:   cp uam-frontend/.env.example uam-frontend/.env  → fill values
# PRODUCTION:    add each variable in your platform dashboard (Vercel / Render)
#                Vercel injects VITE_* vars at build time automatically
# ==============================================================================

# ── API base path ─────────────────────────────────────────────────────────────
# Proxied by nginx to the gateway — do not change this
VITE_API_URL=/api

# ── Gateway proxy (nginx runtime — not a browser variable) ───────────────────
# Docker Compose: http://gateway-edge/api/  and  gateway-edge
# Production:     your deployed gateway-edge internal URL
GATEWAY_PROXY_PASS=
GATEWAY_PROXY_HOST=

# ── Port (Docker / local only) ────────────────────────────────────────────────
UAM_FRONTEND_PORT=8091
