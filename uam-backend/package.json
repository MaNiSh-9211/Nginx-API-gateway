{
  "name": "uam-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -k \"node ./node_modules/typescript-7/bin/tsc -w --preserveWatchOutput\" \"nodemon -q --delay 300ms -w dist -e js dist/index.js\"",
    "build": "node ./node_modules/typescript-7/bin/tsc",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && npm run test:cb",
    "test:cb": "node dist/scripts/test-redis-circuit-breaker.js",
    "drop-users": "npm run build && node dist/scripts/drop-users-collection.js",
    "cleanup-users": "npm run build && node dist/scripts/cleanup-users.js",
    "cleanup-migrations": "npm run build && node dist/scripts/cleanup-expired-migrations.js",
    "check-bio": "npm run build && node dist/scripts/check-user-bio.js",
    "fix-migration": "npm run build && node dist/scripts/fix-migration-merge.js",
    "clear-migration": "npm run build && node dist/scripts/clear-migration-data.js",
    "verify-migration-cleared": "npm run build && node dist/scripts/verify-migration-cleared.js",
    "fix-migration-bio": "npm run build && node dist/scripts/fix-migration-bio.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "uuid": "^13.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.21.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "typescript": "npm:@typescript/typescript6@^6.0.1",
    "typescript-7": "npm:typescript@7.0.1-rc"
  }
}
