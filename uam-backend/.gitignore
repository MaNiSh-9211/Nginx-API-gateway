# ==============================================================================
# uam-backend/.gitignore
# ==============================================================================

# Credential files — never commit
.env
.env.dev
.env.local
.env.production

# .env.example IS committed
!.env.example

# Node.js
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust
target/
**/target/
**/*.rs.bk

# Logs & debug artifacts
*.log
logs/
curl_output.txt
pid_check.txt

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Runtime data
data/users.json
