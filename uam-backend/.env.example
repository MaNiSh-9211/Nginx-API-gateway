# ==============================================================================
# uam-backend/.env.example — committed template, NO real values
# ==============================================================================
# LOCAL / EC2:   cp uam-backend/.env.example uam-backend/.env  → fill values
# PRODUCTION:    add each variable in your platform dashboard (Vercel / Render)
# ==============================================================================

PORT=8080
NODE_ENV=production

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# postgres://user:pass@host:port/dbname  — for managed TLS (Aiven), set PG_SSL=true
DATABASE_URL=
PG_SSL=false
PG_POOL_MIN=2
PG_POOL_MAX=10
PG_APP_NAME=uam-backend

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=
REDIS_PORT=6379
# ACL username — use "default" for Upstash; leave blank for servers without ACL
REDIS_USERNAME=
REDIS_PASSWORD=
# TLS=true required for Upstash and most managed providers (ElastiCache, Redis Cloud, etc.)
REDIS_TLS=true
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_KEEPALIVE_MS=30000
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_MAX_RECONNECT_ATTEMPTS=20

# ── JWT ───────────────────────────────────────────────────────────────────────
# ⚠ Must match JWT_SECRET in gateway-edge and gateway-control-plane
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=api-gateway-auth-server
JWT_AUDIENCE=api-gateway-clients

# ── App secrets ───────────────────────────────────────────────────────────────
PASSWORD_PEPPER=
ADMIN_API_KEY=

# ── App flags ─────────────────────────────────────────────────────────────────
AUTO_VERIFY_EMAIL=true
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_PATH=/api/auth
AUTH_OMIT_REFRESH_IN_BODY=true
BCRYPT_COST=12
DEFAULT_HOME_REGION=US
UAM_DEV_STACK=1
UAM_REFUSE_INSECURE_SECRETS=1
# Rate limiter degradation: 1 = fall back to in-memory limits when Redis is down
# (dev convenience), 0 = STRICT � refuse to start / serve 503 without Redis.
RATE_LIMIT_LOCAL_FALLBACK=0
UAM_REQUIRE_DISTRIBUTED_RATE_LIMIT=1

# ── Service URLs ──────────────────────────────────────────────────────────────
CLIENT_URL=
CONTROL_PLANE_URL=

# ── Metrics ───────────────────────────────────────────────────────────────────
# Bearer token for GET /metrics (empty = open scrape in dev)
METRICS_TOKEN=

# ── OAuth — Google ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── OAuth — GitHub ────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── OpenTelemetry → Grafana Cloud (LGTM) ──────────────────────────────────────
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable telemetry export entirely.
OTEL_SERVICE_NAME=uam-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
# Grafana Cloud OTLP basic auth: Authorization=Basic%20<base64(instance_id:token)>
OTEL_EXPORTER_OTLP_HEADERS=

# ---- Redis Circuit Breaker + Dependency Health Monitor ----------------------
# Local, process-local circuit breaker protecting every Redis command issued by
# this backend (cache pool + rate-limit pool). Same design as the Rust gateway
# and control-plane breakers. All values below are optional.
#
# Rolling window size in seconds (how long health evidence is retained)
REDIS_CB_WINDOW_SECS=10
# Minimum observations before statistical detector activates (prevents tiny-sample flap)
REDIS_CB_MIN_SAMPLES=20
# Consecutive failures before fast-OPEN [1, 100]
REDIS_CB_CONSECUTIVE_FAIL_OPEN=5
# Consecutive timeouts before fast-OPEN [1, 100]
REDIS_CB_CONSECUTIVE_TIMEOUT_OPEN=3
# Rolling error rate threshold for statistical OPEN [0.0, 1.0]
REDIS_CB_ERROR_RATE_OPEN=0.5
# Rolling timeout rate threshold for statistical OPEN [0.0, 1.0]
REDIS_CB_TIMEOUT_RATE_OPEN=0.4
# Rolling p99 latency threshold for statistical OPEN (us) - 250ms default
REDIS_CB_P99_US_OPEN=250000
# p99 latency must be BELOW this to allow HALF_OPEN -> CLOSED recovery (us) - 50ms
REDIS_CB_P99_US_RECOVERY=50000
# Error rate must be BELOW this for HALF_OPEN -> CLOSED recovery
REDIS_CB_ERROR_RATE_RECOVERY=0.1
# Base cooldown before OPEN -> HALF_OPEN (ms)
REDIS_CB_OPEN_COOLDOWN_MS=5000
# Max random jitter added to cooldown (ms) - prevents fleet recovery storms
REDIS_CB_COOLDOWN_JITTER_MS=2000
# Number of probe requests allowed in HALF_OPEN state
REDIS_CB_HALF_OPEN_PROBES=3
# Consecutive probe successes needed to close the circuit
REDIS_CB_RECOVERY_SUCCESSES=3
# Max time HALF_OPEN may stay probing without meeting recovery before the
# circuit re-arms OPEN (ms) - the anti-wedge safety valve [1000, 600000]
REDIS_CB_HALF_OPEN_MAX_MS=10000
# Breaker-level deadline for a single Redis operation (ms) [100, 60000]
# A command still running after this is released as TIMEOUT (not an error)
REDIS_CB_OPERATION_TIMEOUT_MS=5000
# Max Redis operations in flight (concurrency back-pressure)
REDIS_CB_MAX_INFLIGHT=32
