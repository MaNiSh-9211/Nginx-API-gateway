# ==============================================================================
# dev/.env.example
# ==============================================================================
# Committed to the repo — contains NO real credentials.
# This is the master template for the full Docker Compose stack.
#
# LOCAL / EC2
#   cp dev/.env.example dev/.env
#   Fill in every blank value. dev/.env is gitignored.
#   cd dev && docker compose up --build
#
# PRODUCTION (Vercel / Render / Railway)
#   Each service is deployed independently.
#   Paste the relevant variables into that service's platform dashboard.
# ==============================================================================

COMPOSE_PROJECT_NAME=api-gateway

# ── Host ports ────────────────────────────────────────────────────────────────
GATEWAY_PORT=18083
CONTROL_PLANE_PORT=18085
UAM_BACKEND_PORT=18080
FRONTEND_TEST_PORT=8090
UAM_FRONTEND_PORT=8091
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ── Region ────────────────────────────────────────────────────────────────────
GATEWAY_REGION=GLOBAL
FALLBACK_REGION=US
UAM_DEFAULT_HOME_REGION=US

# ── GitHub Token (CI / release scripts) ──────────────────────────────────────
# https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Upstash, Redis Cloud, or self-hosted
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true

# ── Shared JWT secrets ────────────────────────────────────────────────────────
# ⚠  Must be identical across gateway-edge, gateway-control-plane, uam-backend
# Generate:  openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Admin API key ─────────────────────────────────────────────────────────────
# Generate:  openssl rand -hex 24
ADMIN_API_KEY=

# ── Config read token ─────────────────────────────────────────────────────────
CONFIG_READ_TOKEN=

# ── Password pepper ───────────────────────────────────────────────────────────
# ⚠  Must be identical in uam-backend and demo-backend
# Generate:  openssl rand -hex 24
PASSWORD_PEPPER=

# ── MongoDB ───────────────────────────────────────────────────────────────────
# mongodb+srv://USER:PASS@cluster.mongodb.net/uam?retryWrites=true&w=majority
MONGODB_URI=

# ── OAuth — Google ────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── OAuth — GitHub ────────────────────────────────────────────────────────────
# https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── UAM backend ───────────────────────────────────────────────────────────────
UAM_CLIENT_URL=
NODE_ENV=production
AUTO_VERIFY_EMAIL=true
BCRYPT_COST=12
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# ── Demo backend ──────────────────────────────────────────────────────────────
# ⚠  Always 0 in production
AUTH_DEV_TOKENS=0
SERVICE_REGION=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── MongoDB local (optional — --profile local-mongo only) ─────────────────────
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
