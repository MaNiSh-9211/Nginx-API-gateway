# ==============================================================================
# gateway-control-plane/.env.example
# ==============================================================================
# Committed to the repo — contains NO real credentials.
# Every variable this service reads must appear here.
#
# LOCAL / EC2
#   cp gateway-control-plane/.env.example gateway-control-plane/.env
#   Fill in every blank value. .env is gitignored.
#
# PRODUCTION (Vercel / Render / Railway)
#   Paste each variable name + real value into the platform dashboard.
# ==============================================================================

# ── Secrets ───────────────────────────────────────────────────────────────────
# ⚠  Must be identical across gateway-edge and uam-backend
# Generate:  openssl rand -hex 32
JWT_SECRET=

# Authenticates POST /config and POST /config/rollback
# Generate:  openssl rand -hex 24
ADMIN_API_KEY=

# Read-only token for config-sidecar polling /config
# Leave blank to disable token auth on that endpoint
CONFIG_READ_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8081
HOST=0.0.0.0

# ── Config store ──────────────────────────────────────────────────────────────
CONFIG_DIR=./conf.d
CONFIG_HISTORY_LIMIT=20
MAX_CONCURRENCY=50000

# ── Redis ─────────────────────────────────────────────────────────────────────
# Upstash, Redis Cloud, ElastiCache, or self-hosted
REDIS_HOST=
REDIS_PORT=6379
# ACL username — use "default" for Upstash; leave blank for servers without ACL
REDIS_USERNAME=
REDIS_PASSWORD=
# TLS=true required for Upstash and most managed providers
REDIS_TLS=true
REDIS_DB=1

# ── Security ──────────────────────────────────────────────────────────────────
CONTROL_PLANE_REFUSE_INSECURE_SECRETS=1

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=info

# ── Upstream service addresses ────────────────────────────────────────────────
# Set in your deployment platform — do NOT put production hostnames here
UAM_BACKEND_UPSTREAM=
DEMO_BACKEND_UPSTREAM=
