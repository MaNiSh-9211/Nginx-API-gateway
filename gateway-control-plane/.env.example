# ==============================================================================
# gateway-control-plane/.env.example
# ==============================================================================
# Committed to the repo — contains NO real credentials.
# Every variable this service reads must appear here.
#
# LOCAL / EC2
#   cp gateway-control-plane/.env.example gateway-control-plane/.env
#   Fill in every blank value. .env is gitignored.
#
# PRODUCTION (Vercel / Render / Railway)
#   Paste each variable name + real value into the platform dashboard.
# ==============================================================================

# ── Secrets ───────────────────────────────────────────────────────────────────
# ⚠  Must be identical across gateway-edge and uam-backend
# Generate:  openssl rand -hex 32
JWT_SECRET=

# Authenticates POST /config and POST /config/rollback
# Generate:  openssl rand -hex 24
ADMIN_API_KEY=

# Read-only token for config-sidecar polling /config
# Leave blank to disable token auth on that endpoint
CONFIG_READ_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8081
HOST=0.0.0.0

# ── Config store ──────────────────────────────────────────────────────────────
CONFIG_DIR=./conf.d
CONFIG_HISTORY_LIMIT=20
MAX_CONCURRENCY=50000

# ── Redis ─────────────────────────────────────────────────────────────────────
# Upstash, Redis Cloud, ElastiCache, or self-hosted
REDIS_HOST=
REDIS_PORT=6379
# ACL username — use "default" for Upstash; leave blank for servers without ACL
REDIS_USERNAME=
REDIS_PASSWORD=
# TLS=true required for Upstash and most managed providers
REDIS_TLS=true
REDIS_DB=1

# ── Security ──────────────────────────────────────────────────────────────────
CONTROL_PLANE_REFUSE_INSECURE_SECRETS=1

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=info

# ── Upstream service addresses ────────────────────────────────────────────────
# Set in your deployment platform — do NOT put production hostnames here
UAM_BACKEND_UPSTREAM=
DEMO_BACKEND_UPSTREAM=

# ---- PostgreSQL (control-plane owned config store) ---------------------------
# The control plane persists config revisions + audit trail in an ISOLATED
# `control_plane` schema. This is the control plane's OWN operational state
# (ADR-0011) — it never touches uam-backend's `public` user schema (ADR-0050).
#
# Leave DATABASE_URL blank to run in-memory-only (config history lost on restart).
DATABASE_URL=
# TLS encryption for managed Postgres (Aiven, Neon, RDS). Uses `sslmode=require`.
PG_SSL=true
# For production, use a least-privilege role scoped to the control_plane schema
# (see src/store.rs DDL block / PRODUCTION.md):
#   CREATE ROLE control_plane LOGIN PASSWORD '...';
#   CREATE SCHEMA control_plane AUTHORIZATION control_plane;
#   GRANT USAGE ON SCHEMA control_plane TO control_plane;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA control_plane TO control_plane;

# ---- Redis Circuit Breaker + Dependency Health Monitor -----------------------
# Local, process-local circuit breaker protecting the control plane's Redis
# writes (admin-nonce SET NX EX and POST /revoke SET EX). Same design as the
# gateway-edge redis_cb.rs module. All values below are optional.
#
# Operation deadline for every Redis call (connect + read/write), [50, 5000] ms.
# The default 1000ms is generous because control-plane ops are admin-triggered
# and rare; the breaker prevents waiting on a hung Redis regardless.
CP_REDIS_TIMEOUT_MS=1000
# Rolling window size in seconds (how long health evidence is retained)
CP_REDIS_CB_WINDOW_SECS=10
# Minimum observations before statistical detector activates (prevents tiny-sample flap)
CP_REDIS_CB_MIN_SAMPLES=20
# Consecutive failures before fast-OPEN [1, 100]
CP_REDIS_CB_CONSECUTIVE_FAIL_OPEN=5
# Consecutive timeouts before fast-OPEN [1, 100]
CP_REDIS_CB_CONSECUTIVE_TIMEOUT_OPEN=3
# Rolling error rate threshold for statistical OPEN [0.0, 1.0]
CP_REDIS_CB_ERROR_RATE_OPEN=0.5
# Rolling timeout rate threshold for statistical OPEN [0.0, 1.0]
CP_REDIS_CB_TIMEOUT_RATE_OPEN=0.4
# Rolling p99 latency threshold for statistical OPEN (us) - 200ms default
CP_REDIS_CB_P99_US_OPEN=200000
# p99 latency must be BELOW this to allow HALF_OPEN -> CLOSED recovery (us) - 30ms
CP_REDIS_CB_P99_US_RECOVERY=30000
# Error rate must be BELOW this for HALF_OPEN -> CLOSED recovery
CP_REDIS_CB_ERROR_RATE_RECOVERY=0.1
# Base cooldown before OPEN -> HALF_OPEN (ms)
CP_REDIS_CB_OPEN_COOLDOWN_MS=5000
# Max random jitter added to cooldown (ms) - prevents fleet recovery storms
CP_REDIS_CB_COOLDOWN_JITTER_MS=2000
# Number of probe requests allowed in HALF_OPEN state
CP_REDIS_CB_HALF_OPEN_PROBES=3
# Consecutive probe successes needed to close the circuit
CP_REDIS_CB_RECOVERY_SUCCESSES=3
# Max time HALF_OPEN may stay probing without meeting recovery before the
# circuit re-arms OPEN (ms) - the anti-wedge safety valve [1000, 600000]
CP_REDIS_CB_HALF_OPEN_MAX_MS=10000
# Max Redis operations in flight (concurrency back-pressure)
CP_REDIS_CB_MAX_INFLIGHT=32

# ── OpenTelemetry → Grafana Cloud (LGTM) ──────────────────────────────────────
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable telemetry export entirely
# (logging falls back to console-only via tracing).
OTEL_SERVICE_NAME=gateway-control-plane
OTEL_EXPORTER_OTLP_ENDPOINT=
# Grafana Cloud OTLP basic auth: Authorization=Basic%20<base64(instance_id:token)>
OTEL_EXPORTER_OTLP_HEADERS=
