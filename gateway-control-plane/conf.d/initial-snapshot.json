{
  "version": "v1.0.2",
  "global_max_concurrency": 50000,
  "jwt_secret": "super_secret_key_for_hmac_sha256_change_in_prod",
  "expected_issuer": "api-gateway-auth-server",
  "expected_audience": "api-gateway-clients",
  "routes": [
    { "path_prefix": "/api/auth/", "service_name": "uam-auth",       "strip_prefix": false },
    { "path_prefix": "/api/v1/", "service_name": "api-v1",         "strip_prefix": false },
    { "path_prefix": "/public/", "service_name": "public-service", "strip_prefix": false },
    { "path_prefix": "/ratelimit-test/", "service_name": "ratelimit-test", "strip_prefix": false },
    { "path_prefix": "/",        "service_name": "default-service", "strip_prefix": false }
  ],
  "services": {
    "uam-auth": {
      "name": "uam-auth",
      "rate_limit_max": 2000,
      "require_auth": false,
      "regional_upstreams": {
        "EU": [{ "name": "uam-backend", "address": "uam-backend:8080", "weight": 10 }],
        "US": [{ "name": "uam-backend", "address": "uam-backend:8080", "weight": 10 }],
        "AP": [{ "name": "uam-backend", "address": "uam-backend:8080", "weight": 10 }]
      }
    },
    "api-v1": {
      "name": "api-v1",
      "rate_limit_max": 50000,
      "require_auth": true,
      "regional_upstreams": {
        "EU": [
          { "name": "api-eu-1", "address": "api-eu-1:8080", "weight": 10 },
          { "name": "api-eu-2", "address": "api-eu-2:8080", "weight": 10 }
        ],
        "US": [
          { "name": "api-us-1", "address": "api-us-1:8080", "weight": 10 },
          { "name": "api-us-2", "address": "api-us-2:8080", "weight": 10 }
        ],
        "AP": [
          { "name": "api-ap-1", "address": "api-ap-1:8080", "weight": 10 }
        ]
      }
    },
    "public-service": {
      "name": "public-service",
      "rate_limit_max": 1000,
      "require_auth": false,
      "regional_upstreams": {
        "EU": [{ "name": "pub-eu-1", "address": "pub-eu-1:8080", "weight": 10 }],
        "US": [{ "name": "pub-us-1", "address": "pub-us-1:8080", "weight": 10 }],
        "AP": [{ "name": "pub-ap-1", "address": "pub-ap-1:8080", "weight": 10 }]
      }
    },
    "ratelimit-test": {
      "name": "ratelimit-test",
      "rate_limit_max": 5,
      "require_auth": false,
      "regional_upstreams": {
        "EU": [{ "name": "pub-eu-1", "address": "pub-eu-1:8080", "weight": 10 }],
        "US": [{ "name": "pub-us-1", "address": "pub-us-1:8080", "weight": 10 }],
        "AP": [{ "name": "pub-ap-1", "address": "pub-ap-1:8080", "weight": 10 }]
      }
    },
    "default-service": {
      "name": "default-service",
      "rate_limit_max": 10000,
      "require_auth": true,
      "regional_upstreams": {
        "EU": [
          { "name": "eu-backend-1", "address": "eu-backend-1:8080", "weight": 10 },
          { "name": "eu-backend-2", "address": "eu-backend-2:8080", "weight": 10 }
        ],
        "US": [
          { "name": "us-backend-1", "address": "us-backend-1:8080", "weight": 10 },
          { "name": "us-backend-2", "address": "us-backend-2:8080", "weight": 10 }
        ],
        "AP": [
          { "name": "ap-backend-1", "address": "ap-backend-1:8080", "weight": 10 }
        ]
      }
    }
  }
}
