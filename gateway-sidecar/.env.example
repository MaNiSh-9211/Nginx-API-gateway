# ==============================================================================
# gateway-sidecar/.env.example
# ==============================================================================
# Committed to the repo — contains NO real credentials.
# Every variable this service reads must appear here.
#
# LOCAL / EC2
#   cp gateway-sidecar/.env.example gateway-sidecar/.env
#   Fill in every blank value. .env is gitignored.
#
# PRODUCTION
#   Inject variables via your orchestrator (Docker / Kubernetes / Render).
# ==============================================================================

# ── Control plane ─────────────────────────────────────────────────────────────
# Local Docker Compose:  http://control-plane:8081
# Production:            your deployed gateway-control-plane URL
CONTROL_PLANE_URL=

# Read-only token — must match CONFIG_READ_TOKEN in gateway-control-plane
CONFIG_READ_TOKEN=

# ── Config file path ──────────────────────────────────────────────────────────
# Must match the volume mount shared with gateway-edge
GATEWAY_CONFIG_PATH=/etc/gateway/config.json

# ── Polling ───────────────────────────────────────────────────────────────────
CONFIG_POLL_SECS=5

# ── Metrics ───────────────────────────────────────────────────────────────────
# Set 0 on Render so it is not picked up as the web port
METRICS_PORT=9092
