{
  "name": "backend-test-service",
  "version": "1.0.0",
  "private": true,
  "description": "Sample upstream + dev JWT minter used to exercise the API gateway end-to-end.",
  "main": "dist/server.js",
  "scripts": {
    "build": "node ./node_modules/typescript-7/bin/tsc",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "concurrently -k \"node ./node_modules/typescript-7/bin/tsc -w --preserveWatchOutput\" \"nodemon -q --delay 300ms -w dist -e js dist/server.js\"",
    "test": "node ./node_modules/typescript-7/bin/tsc && node dist/users.test.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "typescript": "npm:@typescript/typescript6@^6.0.1",
    "typescript-7": "npm:typescript@rc"
  },
  "engines": {
    "node": ">=20"
  }
}
