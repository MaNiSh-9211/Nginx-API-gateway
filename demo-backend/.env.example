# ==============================================================================
# demo-backend/.env.example — committed template, NO real values
# ==============================================================================
# LOCAL / EC2:   cp demo-backend/.env.example demo-backend/.env  → fill values
# PRODUCTION:    add each variable in your platform dashboard (Vercel / Render)
# ==============================================================================

PORT=8080

# ── JWT ───────────────────────────────────────────────────────────────────────
# ⚠ Must match JWT_SECRET in gateway-edge and gateway-control-plane
JWT_SECRET=

# ── Token claims ──────────────────────────────────────────────────────────────
EXPECTED_ISSUER=api-gateway-auth-server
EXPECTED_AUDIENCE=api-gateway-clients

# ── Password hashing ──────────────────────────────────────────────────────────
# ⚠ Must match PASSWORD_PEPPER in uam-backend
PASSWORD_PEPPER=

# ── App config ────────────────────────────────────────────────────────────────
BCRYPT_COST=12
USER_STORE_PATH=/app/data/users.json

# ── Region ────────────────────────────────────────────────────────────────────
# Tags responses with the region this instance serves (e.g. US, EU, AP, SG)
SERVICE_REGION=

# ── Dev flags ─────────────────────────────────────────────────────────────────
# ⚠ Always 0 in production
AUTH_DEV_TOKENS=0
